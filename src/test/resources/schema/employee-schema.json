{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["status", "data", "message"],
  "properties": {
    "status": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "mes": {
      "type": "integer"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "employee_name",
          "employee_salary",
          "employee_age",
          "profile_image"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "employee_name": {
            "type": "string"
          },
          "employee_salary": {
            "type": "string"
          },
          "employee_age": {
            "type": "string"
          },
          "profile_image": {
            "type": "string"
          }
        }
      }
    }
  }
}
